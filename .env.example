# Base URL of the Axinfra API — the same Next.js backend the web app uses.
# EXPO_PUBLIC_* vars are inlined into the built app, so never put secrets here,
# only the public API base URL.

# Local dev against `npm run dev` in the web repo:
#   iOS Simulator can use localhost directly.
#   Android Emulator must use 10.0.2.2 instead of localhost.
#   A physical device must use your machine's LAN IP (e.g. http://192.168.1.23:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Production:
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app
